generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  role      String     @default("VIEWER")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

model SME {
  id                String             @id @default(cuid())
  name              String
  designation       String?
  institute         String?
  status            String             @default("ACTIVE")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  address           String?
  location          String?
  deputationLetters DeputationLetter[]
  workEntries       SMEWorkEntry[]
}

model SMEWorkEntry {
  id             String     @id @default(cuid())
  smeId          String
  trade          String
  topic          String
  attendanceFrom DateTime?
  attendanceTo   DateTime?
  days           Float?
  ratePerDay     Float?
  taAmount       Float?
  otherAmount    Float?
  status         String     @default("PENDING")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  topicId        String?
  epicSequence   Int        @default(autoincrement())
  documents      Document[]
  payments       Payment[]
  sme            SME        @relation(fields: [smeId], references: [id], onDelete: Cascade)
  topicRef       Topic?     @relation(fields: [topicId], references: [id])
}

model Payment {
  id           String        @id @default(cuid())
  workEntryId  String
  grossAmount  Float
  taAmount     Float?
  otherAmount  Float?
  totalAmount  Float
  status       String        @default("DRAFT")
  utrNumber    String?
  paymentDate  DateTime?
  remarks      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  budgetHeadId String?
  documents    Document[]
  expenditures Expenditure[]
  workEntry    SMEWorkEntry  @relation(fields: [workEntryId], references: [id], onDelete: Cascade)
}

model BudgetHead {
  id             String        @id @default(cuid())
  name           String        @unique
  approvedBudget Float         @default(0)
  utilizedAmount Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  expenditures   Expenditure[]
}

model Expenditure {
  id              String     @id @default(cuid())
  budgetHeadId    String
  amount          Float
  description     String?
  transactionDate DateTime   @default(now())
  status          String     @default("PENDING")
  paymentId       String?
  hrSalaryId      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  budgetHead      BudgetHead @relation(fields: [budgetHeadId], references: [id])
  hrSalary        HRSalary?  @relation(fields: [hrSalaryId], references: [id])
  payment         Payment?   @relation(fields: [paymentId], references: [id])
}

model HumanResource {
  id          String     @id @default(cuid())
  name        String
  role        String
  joiningDate DateTime
  baseSalary  Float
  allowances  Float      @default(0)
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  salaries    HRSalary[]
}

model HRSalary {
  id           String        @id @default(cuid())
  hrId         String
  month        String
  year         String
  totalAmount  Float
  status       String        @default("PENDING")
  utrNumber    String?
  paymentDate  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  expenditures Expenditure[]
  hr           HumanResource @relation(fields: [hrId], references: [id], onDelete: Cascade)
}

model Document {
  id          String        @id @default(cuid())
  name        String
  type        String
  status      String        @default("UPLOADED")
  filePath    String?
  version     Int           @default(1)
  workEntryId String?
  paymentId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  projectId   String?
  payment     Payment?      @relation(fields: [paymentId], references: [id])
  project     Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workEntry   SMEWorkEntry? @relation(fields: [workEntryId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  action       String
  entity       String
  entityId     String
  previousData String?
  newData      String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id])
}

model Language {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Status {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Trade {
  id       String    @id @default(cuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id                String             @id @default(cuid())
  projectCode       String             @unique
  title             String
  tradeId           String?
  languageId        String?
  statusId          String?
  startDate         DateTime?
  completionDate    DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deputationLetters DeputationLetter[]
  documents         Document[]
  modules           Module[]
  production        ProductionRecord[]
  language          Language?          @relation(fields: [languageId], references: [id])
  status            Status?            @relation(fields: [statusId], references: [id])
  trade             Trade?             @relation(fields: [tradeId], references: [id])
}

model Module {
  id           String  @id @default(cuid())
  moduleNumber String
  name         String?
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topics       Topic[]
}

model Topic {
  id             String         @id @default(cuid())
  name           String
  moduleId       String
  smeWorkEntries SMEWorkEntry[]
  module         Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model ProductionRecord {
  id        String    @id @default(cuid())
  projectId String
  videoUrl  String?
  shootDate DateTime?
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ImportBatch {
  id               String         @id @default(cuid())
  originalFileName String
  sheetName        String?
  importedBy       String
  importDate       DateTime       @default(now())
  legacyRecords    LegacyRecord[]
}

model LegacyRecord {
  id           String      @id @default(cuid())
  batchId      String
  originalRow  Int
  rawData      String
  projectId    String?
  smeId        String?
  status       String      @default("SUCCESS")
  errorMessage String?
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

model DeputationLetter {
  id              String    @id @default(cuid())
  referenceNumber String
  letterDate      DateTime
  year            String
  smeId           String
  projectId       String?
  approvalPeriod  String
  extensionDate   DateTime?
  version         Int       @default(1)
  pdfPath         String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project?  @relation(fields: [projectId], references: [id])
  sme             SME       @relation(fields: [smeId], references: [id], onDelete: Cascade)
}

model BudgetComponent {
  id             String        @id @default(cuid())
  componentNo    Int           @unique
  name           String
  approvedBudget Float
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  annexureI      AnnexureI[]
  annexureII     AnnexureII[]
  annexureIII    AnnexureIII[]
  annexureIV     AnnexureIV[]
  annexureV      AnnexureV[]
  annexureVI     AnnexureVI[]
}

model AnnexureI {
  id                 String          @id @default(cuid())
  budgetComponentId  String
  datePeriod         String
  expertName         String
  designation        String
  activity           String
  workingDays        Float
  honorarium         Float           @default(0)
  travelAllowance    Float           @default(0)
  otherCharges       Float           @default(0)
  totalExpenditure   Float           @default(0)
  utrNumber          String?
  contentDuration    String?
  approvalRef        String?
  remarks            String?
  supportingDoc      String?
  verificationStatus String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Excel Import Fields
  tranType           String?
  voucherNo          String?
  transactionDate    DateTime?
  commitmentNo       String?
  commitmentDate     DateTime?
  narration          String?
  
  budgetComponent    BudgetComponent @relation(fields: [budgetComponentId], references: [id], onDelete: Cascade)
}

model AnnexureII {
  id                 String          @id @default(cuid())
  budgetComponentId  String
  datePeriod         String
  trainingName       String
  trainingType       String
  participant        String
  venue              String
  noOfParticipants   Int             @default(0)
  trainingDays       Float
  trainerFee         Float           @default(0)
  trainingCost       Float           @default(0)
  travelAllowance    Float           @default(0)
  accommodation      Float           @default(0)
  otherExpenses      Float           @default(0)
  totalExpenditure   Float           @default(0)
  utrNumber          String?
  approvalRef        String?
  remarks            String?
  supportingDoc      String?
  verificationStatus String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  trainingDates      String?
  budgetComponent    BudgetComponent @relation(fields: [budgetComponentId], references: [id], onDelete: Cascade)
}

model AnnexureIII {
  id                 String          @id @default(cuid())
  budgetComponentId  String
  datePeriod         String
  personnelName      String
  designation        String
  supportType        String
  department         String
  workPeriod         String
  remuneration       Float           @default(0)
  taDa               Float           @default(0)
  otherCharges       Float           @default(0)
  totalExpenditure   Float           @default(0)
  utrNumber          String?
  approvalRef        String?
  remarks            String?
  supportingDoc      String?
  verificationStatus String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  // Excel Import Fields
  tranType           String?
  voucherNo          String?
  transactionDate    DateTime?
  commitmentNo       String?
  commitmentDate     DateTime?
  narration          String?
  
  budgetComponent    BudgetComponent @relation(fields: [budgetComponentId], references: [id], onDelete: Cascade)
}

model AnnexureIV {
  id                 String          @id @default(cuid())
  budgetComponentId  String
  datePeriod         String
  service            String
  description        String
  vendor             String
  purchaseRef        String
  quantity           Int             @default(1)
  unitCost           Float           @default(0)
  servicePeriod      String
  infrastructureCost Float           @default(0)
  bandwidthCost      Float           @default(0)
  archiveCost        Float           @default(0)
  otherCharges       Float           @default(0)
  totalExpenditure   Float           @default(0)
  invoiceNo          String?
  utrNumber          String?
  remarks            String?
  supportingDoc      String?
  verificationStatus String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  budgetComponent    BudgetComponent @relation(fields: [budgetComponentId], references: [id], onDelete: Cascade)
}

model AnnexureV {
  id                 String          @id @default(cuid())
  budgetComponentId  String
  datePeriod         String
  school             String
  activity           String
  equipment          String
  quantity           Int             @default(1)
  unitCost           Float           @default(0)
  installationCost   Float           @default(0)
  transportation     Float           @default(0)
  otherCharges       Float           @default(0)
  totalExpenditure   Float           @default(0)
  vendor             String
  invoiceNo          String?
  utrNumber          String?
  remarks            String?
  supportingDoc      String?
  verificationStatus String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  budgetComponent    BudgetComponent @relation(fields: [budgetComponentId], references: [id], onDelete: Cascade)
}

model AnnexureVI {
  id                 String          @id @default(cuid())
  budgetComponentId  String
  platform           String
  campaignDesc       String
  datePeriod         String
  serviceProvider    String
  campaignType       String
  amount             Float           @default(0)
  tax                Float           @default(0)
  totalExpenditure   Float           @default(0)
  utrNumber          String?
  approvalRef        String?
  remarks            String?
  supportingDoc      String?
  verificationStatus String          @default("DRAFT")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  budgetComponent    BudgetComponent @relation(fields: [budgetComponentId], references: [id], onDelete: Cascade)
}

model VideoLibrary {
  id        String   @id @default(cuid())
  smeName   String
  title     String
  videoLink String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  duration  String?
  trade     String?
}
